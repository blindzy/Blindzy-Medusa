{
  "name": "medusa-starter-default",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 medusa develop",
    "dev:local": "NODE_ENV=development medusa develop",
    "setup": "npm install && echo 'Please copy env.local.example to .env.local and configure your environment variables'",
    "docker:dev": "docker-compose up medusa",
    "docker:build": "docker-compose build",
    "vercel-build": "npm run build",
    "postinstall": "echo 'Skipping build due to TypeScript errors - run npm run dev to start development'",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.8.7",
    "@medusajs/cli": "^2.8.8",
    "@medusajs/core-flows": "^2.8.8",
    "@medusajs/customer": "^2.8.8",
    "@medusajs/framework": "^2.8.8",
    "@medusajs/medusa": "^2.8.8",
    "@medusajs/workflows-sdk": "^2.8.8",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/knex": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/postgresql": "6.4.16",
    "@types/jsonwebtoken": "^9.0.10",
    "awilix": "^8.0.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.13.0",
    "redis": "^4.7.1",
    "resend": "^4.7.0",
    "uuid": "^10.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@medusajs/test-utils": "^2.8.8",
    "@mikro-orm/cli": "6.4.16",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.25",
    "typescript": "^5.6.2",
    "vite": "^5.2.11",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20"
  }
}
